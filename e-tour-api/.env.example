# Database Configuration
# Required in production, optional in development (will use appsettings.json default)
DATABASE_CONNECTION_STRING=Host=localhost;Database=etour;Username=postgres;Password=postgres;

# JWT Configuration
# Required in production, optional in development (will use appsettings.json default)
JWT_KEY=your-secure-jwt-key-min-32-chars
JWT_ISSUER=https://your-domain.com
JWT_AUDIENCE=https://your-domain.com
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7
JWT_KEY_ROTATION_DAYS=30
JWT_MINIMUM_KEY_LENGTH=32
JWT_REQUIRE_HTTPS=true
JWT_VALIDATE_ISSUER=true
JWT_VALIDATE_AUDIENCE=true
JWT_VALIDATE_LIFETIME=true
JWT_VALIDATE_ISSUER_SIGNING_KEY=true

# Frontend URL
# Required in production, optional in development (will use appsettings.json default)
FRONTEND_URL=https://your-frontend-domain.com

# CORS Configuration
# Required in production, optional in development (will use appsettings.json default)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# File Storage Configuration
# Optional - will use appsettings.json defaults if not set
FILE_STORAGE_PATH=./uploads
FILE_MAX_SIZE_BYTES=10485760
FILE_ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png

# Security Configuration
# Optional - will use appsettings.json defaults if not set
REQUIRE_HTTPS=true
PASSWORD_MIN_LENGTH=8
SESSION_TIMEOUT_MINUTES=60

# Rate Limiting Configuration
# Optional - will use appsettings.json defaults if not set
RATE_LIMIT_PERMIT=100
RATE_LIMIT_WINDOW_MINUTES=1 