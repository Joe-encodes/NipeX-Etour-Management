<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>e_tour_api</RootNamespace>
	  <UserSecretsId>28da779b-ece3-49d9-a9c7-0d035aa3a67a</UserSecretsId>
  </PropertyGroup>

	<ItemGroup>
