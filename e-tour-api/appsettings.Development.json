{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  },
  "DefaultConnection": {
    "DefaultConnection": "Host=localhost;Database=etour;Username=postgres;Password=postgres;"
  },
  "Jwt": {
    "Key": "dev-super-secret-key-min-32-chars-long-12345",
    "Issuer": "https://localhost:7078",
    "Audience": "https://localhost:7078",
    "ExpiryMinutes": 15,
    "RefreshExpiryDays": 7,
    "KeyRotationDays": 30,
    "MinimumKeyLength": 32,
    "RequireHttps": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateIssuerSigningKey": true
  },
  "Frontend": {
    "Url": "https://localhost:3000"
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:3000"],
    "AllowedMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "AllowedHeaders": ["Content-Type", "Authorization"],
    "AllowCredentials": true
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowMinutes": 1
  },
  "FileStorage": {
    "Path": "./uploads",
    "MaxSizeBytes": 10485760,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png"]
  },
  "Security": {
    "RequireHttps": true,
    "PasswordMinLength": 8,
    "SessionTimeoutMinutes": 60
  },
  "Email": {
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "dev-email@gmail.com",
    "SmtpPassword": "dev-app-specific-password",
    "FromEmail": "dev-email@gmail.com",
    "BaseUrl": "https://localhost:3000"
  },
  "Encryption": {
    "Key": "dev-encryption-key-min-32-chars-long-12345"
  }
}
